# Copied to .env on first run. Where aider should reach Ollama.
#
# Ollama running on this machine, which is where it puts itself:
OLLAMA_API_BASE=http://127.0.0.1:11434

# The model on a lab computer, arriving over the tunnel. Not 11434, so it can
# coexist with a local Ollama instead of fighting it for the port - uncomment
# this line and comment the one above when you want the lab machine's GPU:
# OLLAMA_API_BASE=http://127.0.0.1:11435

# A machine you can reach directly (a desktop on your tailnet, say):
# OLLAMA_API_BASE=http://gpu-box.example:11434

# aider loads this file with override, so it beats the same variable set in
# your shell. `OLLAMA_API_BASE=... aider` looks like it should work and does
# nothing. Edit the file.
