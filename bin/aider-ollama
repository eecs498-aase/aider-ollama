#!/usr/bin/env bash
# Run aider against Ollama, wherever Ollama happens to be.
#
#   aider-ollama start [--build]   make sure the model is reachable, run aider
#   aider-ollama stop              stop the Ollama this machine started
#   aider-ollama restart           stop, then start --build
#   aider-ollama status            what aider will actually talk to
#   aider-ollama model <name>      point the config at a model, and add a
#                                  settings block for it if it has none
#
# Any arguments after the subcommand are passed through to aider.
#
# Run this from a repo that has the config files from this project in it - see
# the README. `start` is the only command that touches Ollama or downloads
# anything.
set -euo pipefail

ROOT="$(pwd)"
[ -f "$ROOT/.env" ] || { [ -f "$ROOT/.env.example" ] && cp "$ROOT/.env.example" "$ROOT/.env" && echo "aider-ollama: created .env"; }
# aider loads .env with override, so read it here too - otherwise `status`
# reports a different server from the one aider is about to use.
if [ -f "$ROOT/.env" ]; then set -a; . "$ROOT/.env"; set +a; fi

API="${OLLAMA_API_BASE:-http://127.0.0.1:11434}"
CONF="$ROOT/.aider.conf.yml"
SETTINGS="$ROOT/.aider.model.settings.yml"
CONF_MODEL="$(sed -n 's/^model: *ollama_chat\///p' "$CONF" 2>/dev/null | head -1)"
MODEL="${MODEL:-${AIDER_MODEL#ollama_chat/}}"; MODEL="${MODEL:-$CONF_MODEL}"
TUNNEL_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/aider-ollama/tunnel.conf"

green=$'\033[32m'; red=$'\033[31m'; dim=$'\033[2m'; off=$'\033[0m'
[ -t 1 ] || { green=""; red=""; dim=""; off=""; }

up()      { curl -sf -m 5 "$API/api/tags" >/dev/null 2>&1; }
models()  { curl -sf -m 5 "$API/api/tags" 2>/dev/null | tr ',{}' '\n\n\n' | sed -n 's/.*"name":"\([^"]*\)".*/\1/p'; }
pulled()  { models | grep -qx "$1"; }
# Anything that is not loopback is someone else's machine, and we must not try
# to start or pull on it.
remote()  { case "$API" in *//127.0.0.1[:/]*|*//localhost[:/]*) return 1 ;; *) return 0 ;; esac; }

start_ollama() {
  up && return 0
  remote && { echo "aider-ollama: cannot reach Ollama at $API - that is another machine." >&2; return 1; }
  # A tunnel also looks local: 127.0.0.1 here is the near end of an SSH
  # forward. Starting a server on this machine would be wrong twice - no
  # weights, and the port is already held by the forward.
  if [ -f "$TUNNEL_CONF" ]; then
    echo "aider-ollama: the tunnel to your other machine is down." >&2
    echo "  ollama-tunnel status     which hop" >&2
    echo "  ollama-tunnel start      bring this half up" >&2
    return 1
  fi
  command -v ollama >/dev/null 2>&1 || { echo "aider-ollama: no ollama - see https://ollama.com/download" >&2; return 1; }
  echo "aider-ollama: starting Ollama..."
  if [ -d /Applications/Ollama.app ]; then open -a Ollama
  else OLLAMA_HOST="${API#*://}" nohup ollama serve >"/tmp/ollama-serve-$USER.log" 2>&1 & fi
  for _ in $(seq 1 30); do up && return 0; sleep 1; done
  echo "aider-ollama: Ollama did not come up at $API" >&2; return 1
}

# Without a settings entry litellm assumes a 2048-token context and aider
# silently truncates your files. That failure looks exactly like a stupid
# model, so never let a model be selected without one.
ensure_settings() {
  grep -q "^- name: ollama_chat/$1\$" "$SETTINGS" 2>/dev/null && return 0
  cat >> "$SETTINGS" <<EOF

- name: ollama_chat/$1
  edit_format: whole
  use_repo_map: true
  extra_params:
    num_ctx: 32768
EOF
  echo "aider-ollama: added a settings block for $1 ${dim}(32K context, whole-file edits)${off}"
}

case "${1:-status}" in
  start)
    shift; [ "${1:-}" = "--build" ] && shift || true
    start_ollama
    ensure_settings "$MODEL"
    if ! pulled "$MODEL"; then
      remote && { echo "aider-ollama: $MODEL is not on $API. Pull it there." >&2; exit 1; }
      echo "aider-ollama: pulling $MODEL - this is the slow part, once."
      ollama pull "$MODEL"
    fi
    exec aider --model "ollama_chat/$MODEL" "$@"
    ;;
  stop)
    remote && { echo "aider-ollama: $API is another machine; not stopping anything."; exit 0; }
    [ -f "$TUNNEL_CONF" ] && { echo "aider-ollama: the model is on another machine. ollama-tunnel stop"; exit 0; }
    [ -d /Applications/Ollama.app ] && osascript -e 'quit app "Ollama"' 2>/dev/null || true
    pkill -f "ollama serve" 2>/dev/null || true
    echo "aider-ollama: stopped."
    ;;
  restart) "$0" stop; exec "$0" start --build ;;
  model)
    [ -n "${2:-}" ] || { echo "usage: aider-ollama model <name>   e.g. qwen3.5:9b" >&2; exit 1; }
    sed -i.bak "s|^model: .*|model: ollama_chat/$2|" "$CONF" && rm -f "$CONF.bak"
    ensure_settings "$2"
    echo "aider-ollama: model is now ollama_chat/$2 ${dim}(next start pulls it)${off}"
    ;;
  status)
    up && echo "Ollama:   ${green}reachable${off} at $API" || echo "Ollama:   ${red}no answer${off} at $API"
    echo "Where:    $(remote && echo "another machine" || { [ -f "$TUNNEL_CONF" ] && echo "tunnelled from another machine" || echo "this machine"; })"
    echo "Model:    ollama_chat/$MODEL"
    up && { pulled "$MODEL" && echo "Pulled:   ${green}yes${off}" || echo "Pulled:   ${red}no${off} ${dim}(start will pull it)${off}"; }
    grep -q "^- name: ollama_chat/$MODEL\$" "$SETTINGS" 2>/dev/null \
      && echo "Context:  $(sed -n "/^- name: ollama_chat\/$MODEL\$/,/^\$/p" "$SETTINGS" | sed -n 's/.*num_ctx: //p') tokens" \
      || echo "Context:  ${red}2048${off} - no settings block, aider will truncate your files"
    ;;
  *) echo "usage: aider-ollama {start|stop|restart|status|model <name>}" >&2; exit 2 ;;
esac
