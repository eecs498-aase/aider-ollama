#!/usr/bin/env bash
# Symlink the tunnel commands into ~/.local/bin so they work from any directory.
#
#   bin/install            link them
#   bin/install --remove   unlink them
#
# Nothing else is written, nothing needs root, and re-running is safe.
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEST="${PREFIX:-$HOME/.local/bin}"
CMDS="ollama-tunnel ollama-relay"

mkdir -p "$DEST"
for c in $CMDS; do
  if [ "${1:-}" = "--remove" ]; then
    [ -L "$DEST/$c" ] && rm -f "$DEST/$c" && echo "unlinked $DEST/$c"
  else
    ln -sf "$SRC/$c" "$DEST/$c" && echo "linked $DEST/$c"
  fi
done
[ "${1:-}" = "--remove" ] && exit 0
case ":$PATH:" in
  *":$DEST:"*) ;;
  *) echo
     echo "$DEST is not on your PATH. Add this to your shell profile:"
     echo "    export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
esac
