#!/usr/bin/env bash
# Install aider on a CAEN machine, and keep it working there.
#
#   bin/install-aider                  once, from your clone of this repo
#   bin/install-aider --force          rebuild over an existing copy
#   bin/install-aider --prefix DIR     build somewhere other than the default
#
# Your CAEN home is a network share, mounted on every lab machine. That is
# right for Ollama and for the models it pulls: a few big files that read at
# full speed and follow you from machine to machine. It is wrong for aider,
# which is a Python program that opens several hundred small files to start.
# From a network home every one of those is a round trip, aider takes tens of
# seconds to reach a prompt, and it feels broken. So this builds aider on the
# local disk of the machine you are sitting at, where the same install starts
# in seconds.
#
# Local disk belongs to one machine and gets cleaned. So this also leaves a
# launcher at ~/.local/bin/aider, and the launcher is what runs when you type
# `aider`: it checks for the local build and, at a machine that does not have
# one, rebuilds it (about a minute) before starting. There is nothing to
# remember when you move machines and nothing to re-run.
#
# On your own laptop you do not need this. Use the normal installer:
#   python3 -m pip install aider-install && aider-install
set -euo pipefail

PREFIX=""
FORCE=""
FROM_LAUNCHER=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prefix) PREFIX="${2:?--prefix needs a directory}"; shift 2 ;;
    --force)  FORCE=1; shift ;;
    # The launcher rebuilds with this: build only, leave the launcher alone,
    # skip the summary.
    --from-launcher) FROM_LAUNCHER=1; shift ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "install-aider: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

say() { echo "install-aider: $*"; }
die() { echo "install-aider: $*" >&2; exit 1; }

USER_NAME="${USER:-$(id -un)}"
# The launcher recomputes the default at run time rather than baking in
# today's value, because TMPDIR can differ between machines and sessions.
if [ -n "$PREFIX" ]; then
  PREFIX_LINE="$(printf '%q' "$PREFIX")"
else
  PREFIX="${TMPDIR:-/tmp}/aider-$USER_NAME"
  PREFIX_LINE='"${TMPDIR:-/tmp}/aider-${USER:-$(id -un)}"'
fi

# Refuse to do the one thing this script exists to avoid.
case "$PREFIX" in
  "$HOME"|"$HOME"/*) die "$PREFIX is inside your home, which is the network share
  this script exists to stay off. Pass --prefix with a local-disk path." ;;
esac

# aider-chat publishes wheels for a range of Python versions, and a machine
# whose `python3` sits outside it makes pip try to build from source, which
# fails on a missing compiler or a missing setuptools rather than saying the
# version is wrong. So pick a known-good interpreter rather than whatever
# `python3` happens to be, and only fall back to it if none is present.
pick_python() {
  for p in python3.12 python3.11 python3.13 python3.10 python3; do
    command -v "$p" >/dev/null 2>&1 || continue
    "$p" -c 'import sys; raise SystemExit(0 if (3,10) <= sys.version_info < (3,14) else 1)' \
      2>/dev/null && { echo "$p"; return 0; }
  done
  command -v python3 >/dev/null 2>&1 && { echo python3; return 0; }
  return 1
}

if [ -x "$PREFIX/bin/aider" ] && [ -z "$FORCE" ]; then
  say "already built on this machine: $PREFIX/bin/aider"
else
  PY="$(pick_python)" || die "no python3 on this machine"
  say "using $PY ($("$PY" -c 'import sys; print(".".join(map(str,sys.version_info[:3])))'))"
  say "building a virtualenv on local disk: $PREFIX"
  rm -rf "$PREFIX"
  mkdir -p "$PREFIX"
  "$PY" -m venv "$PREFIX" || die "could not create the virtualenv"
  # Pip's own cache defaults into ~/.cache, which is the network share again.
  export PIP_CACHE_DIR="$PREFIX/pip-cache"
  "$PREFIX/bin/pip" install -q --upgrade pip setuptools wheel \
    || die "could not prepare pip"
  say "installing aider (a minute or so)..."
  "$PREFIX/bin/pip" install -q aider-chat || die "could not install aider-chat
  If pip tried to build a package from source, this machine's Python is outside
  the range aider publishes wheels for. Check: $PY --version"
fi

[ -n "$FROM_LAUNCHER" ] && exit 0

# --- the launcher, and a copy of this script for it to call ------------------
# Both go in your home, which every lab machine mounts: two small files, which
# the share serves fine. The copy is so the launcher keeps working after you
# delete or move this clone.
LIBEXEC="$HOME/.local/share/aider-ollama"
INSTALLER="$LIBEXEC/install-aider"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
mkdir -p "$LIBEXEC" "$HOME/.local/bin"
if [ "$SELF" != "$INSTALLER" ]; then
  cp "$SELF" "$INSTALLER"
  chmod 755 "$INSTALLER"
fi

LAUNCHER="$HOME/.local/bin/aider"
if [ -e "$LAUNCHER" ] && ! grep -q 'Written by aider-ollama' "$LAUNCHER" 2>/dev/null; then
  say "replacing the aider at $LAUNCHER (an install in your home, the slow one) with the launcher"
fi
launcher="$(cat <<'LAUNCHER'
#!/usr/bin/env bash
# Written by aider-ollama's bin/install-aider. Re-run that rather than editing this.
#
# aider lives on this machine's local disk, not in your home: home is a network
# share and aider cannot start quickly from one. Local disk is per-machine and
# gets cleaned, so when the build is missing this makes it again (about a
# minute), then runs it.
set -euo pipefail
PREFIX=@PREFIX_LINE@
INSTALLER="$HOME/.local/share/aider-ollama/install-aider"
if [ ! -x "$PREFIX/bin/aider" ]; then
  echo "aider: not built on this machine yet. Building it, about a minute." >&2
  [ -x "$INSTALLER" ] || {
    echo "aider: the installer is gone: $INSTALLER" >&2
    echo "  git clone https://github.com/eecs498-aase/aider-ollama.git && aider-ollama/bin/install-aider" >&2
    exit 1
  }
  "$INSTALLER" --prefix "$PREFIX" --from-launcher >&2
fi
exec "$PREFIX/bin/aider" "$@"
LAUNCHER
)"
printf '%s\n' "${launcher//@PREFIX_LINE@/$PREFIX_LINE}" > "$LAUNCHER"
chmod 755 "$LAUNCHER"

# --- PATH --------------------------------------------------------------------
# `aider` has to resolve to the launcher, so ~/.local/bin has to be on the PATH.
# On the CAEN machines it normally already is. When it is not, add it to the
# shell's startup file and say what to do for this terminal.
path_note=""
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *)
    line='export PATH="$HOME/.local/bin:$PATH"'
    found=""
    for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
      [ -f "$rc" ] || continue
      found=1
      grep -qF '.local/bin' "$rc" && continue
      printf '\n# added by aider-ollama bin/install-aider\n%s\n' "$line" >> "$rc"
    done
    [ -n "$found" ] || printf '# added by aider-ollama bin/install-aider\n%s\n' "$line" >> "$HOME/.bashrc"
    path_note="  ~/.local/bin was not on your PATH. It is now, for new terminals.
  For this one, run:  $line
"
    ;;
esac

ver="$("$PREFIX/bin/aider" --version 2>&1 | head -1)"
cat <<MSG

Installed. $ver

  aider is on this machine's local disk, with a launcher at ~/.local/bin/aider
  that rebuilds it at any machine that does not have it yet. Type: aider

$path_note
MSG
