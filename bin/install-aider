#!/usr/bin/env bash
# Install aider onto a CAEN machine's local disk, not into your home.
#
#   bin/install-aider                  into $TMPDIR/aider-$USER
#   bin/install-aider --prefix DIR     somewhere else
#   bin/install-aider --force          rebuild over an existing copy
#
# Your CAEN home is an NFS share. aider is a Python program that imports several
# hundred files at startup, and every one of those is a network round trip, so
# an aider installed in your home takes tens of seconds to get to a prompt and
# feels broken. The fix is not a faster machine, it is a local disk: the same
# install, on a filesystem attached to the computer you are sitting at.
#
# The cost is that local disk is per-machine and gets cleaned, so you re-run
# this when you come back to a different machine or after a reboot. It takes
# under a minute, which is less than one slow aider startup.
#
# On your own laptop you do not need this. Use the normal installer:
#   python3 -m pip install aider-install && aider-install
set -euo pipefail

PREFIX="${TMPDIR:-/tmp}/aider-$USER"
FORCE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prefix) PREFIX="${2:?--prefix needs a directory}"; shift 2 ;;
    --force)  FORCE=1; shift ;;
    -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "install-aider: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

say() { echo "install-aider: $*"; }
die() { echo "install-aider: $*" >&2; exit 1; }

# Refuse to do the one thing this script exists to avoid.
case "$PREFIX" in
  "$HOME"|"$HOME"/*) die "$PREFIX is inside your home, which is the NFS share
  this script exists to stay off. Pass --prefix with a local-disk path." ;;
esac

# aider-chat publishes wheels for a range of Python versions, and a machine
# whose `python3` sits outside it makes pip try to build from source, which
# fails on a missing compiler or a missing setuptools rather than saying the
# version is wrong. So pick a known-good interpreter rather than whatever
# `python3` happens to be, and only fall back to it if none is present.
pick_python() {
  for p in python3.12 python3.11 python3.13 python3.10 python3; do
    command -v "$p" >/dev/null 2>&1 || continue
    "$p" -c 'import sys; raise SystemExit(0 if (3,10) <= sys.version_info < (3,14) else 1)' \
      2>/dev/null && { echo "$p"; return 0; }
  done
  command -v python3 >/dev/null 2>&1 && { echo python3; return 0; }
  return 1
}

if [ -x "$PREFIX/bin/aider" ] && [ -z "$FORCE" ]; then
  say "already installed: $PREFIX/bin/aider"
  say "use --force to rebuild"
else
  PY="$(pick_python)" || die "no python3 on this machine"
  say "using $PY ($("$PY" -c 'import sys; print(".".join(map(str,sys.version_info[:3])))'))"
  say "building a virtualenv on local disk: $PREFIX"
  rm -rf "$PREFIX"
  mkdir -p "$PREFIX"
  "$PY" -m venv "$PREFIX" || die "could not create the virtualenv"
  # Pip's own cache defaults into ~/.cache, which is the NFS share again.
  export PIP_CACHE_DIR="$PREFIX/pip-cache"
  "$PREFIX/bin/pip" install -q --upgrade pip setuptools wheel \
    || die "could not prepare pip"
  say "installing aider (a minute or so)..."
  "$PREFIX/bin/pip" install -q aider-chat || die "could not install aider-chat
  If pip tried to build a package from source, this machine's Python is outside
  the range aider publishes wheels for. Check: $PY --version"
fi

ver="$("$PREFIX/bin/aider" --version 2>&1 | head -1)"
cat <<MSG

Installed. $ver

  Put it on your PATH for this session:

      export PATH="$PREFIX/bin:\$PATH"

  Then: aider --version

  This lives on the local disk of this machine only. On another CAEN machine,
  or after a reboot, run this again.
MSG
