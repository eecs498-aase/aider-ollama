#!/usr/bin/env bash
# Choose which Ollama aider talks to, in the project you are standing in.
#
#   bin/use              which one is active now
#   bin/use local        the model on this machine        (127.0.0.1:11434)
#   bin/use caen         the model on a CAEN lab machine  (127.0.0.1:11435)
#
# Both are just .env files. This copies one over .env, which is the file aider
# reads. Swapping back is the same command with the other word.
#
# Run it from your project, not from this clone - .env belongs to the project.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
green=$'\033[32m'; dim=$'\033[2m'; red=$'\033[31m'; off=$'\033[0m'
[ -t 1 ] || { green=""; dim=""; red=""; off=""; }

active() {
  [ -f .env ] || { echo "none"; return; }
  case "$(sed -n 's|.*OLLAMA_API_BASE=http://127.0.0.1:||p' .env | head -1)" in
    11434*) echo local ;;
    11435*) echo caen ;;
    *)      echo other ;;
  esac
}

case "${1:-}" in
  "")
    a="$(active)"
    case "$a" in
      none)  echo "no .env here. ${dim}bin/use local${off}, or ${dim}bin/use caen${off}" ;;
      other) echo "$(sed -n 's/^ *export *//p;s/^ *\(OLLAMA_API_BASE=.*\)/\1/p' .env | head -1) ${dim}(not one of the two)${off}" ;;
      *)     echo "${green}$a${off}  $(sed -n 's|.*\(http://127.0.0.1:[0-9]*\).*|\1|p' .env | head -1)" ;;
    esac
    ;;
  local|caen)
    src="$HERE/.env.$1"
    [ -f "$src" ] || { echo "bin/use: no $src" >&2; exit 1; }
    # Keep whatever else the project put in .env - only the API base is ours.
    if [ -f .env ] && grep -qv '^\s*\(#.*\)\?$' .env 2>/dev/null && \
       grep -qv 'OLLAMA_API_BASE' .env 2>/dev/null; then
      grep -v 'OLLAMA_API_BASE' .env > .env.keep 2>/dev/null || true
      cat "$src" .env.keep > .env && rm -f .env.keep
    else
      cp "$src" .env
    fi
    echo "bin/use: ${green}$1${off}  $(sed -n 's|.*\(http://127.0.0.1:[0-9]*\).*|\1|p' .env | head -1)"
    echo "         ${dim}bin/check to prove it works${off}"
    ;;
  *) echo "usage: bin/use [local|caen]" >&2; exit 2 ;;
esac
